@using RecipeApp_Eboaguillaume.Models

<!-- Composant pour éditer une seule ligne d'ingrédient dans une recette. -->
<div class="ingredient-row">
    <RadzenTextBox @bind-Value="Line.Name" Placeholder="Ingrédient" Style="width: 220px" />
    <RadzenNumeric @bind-Value="Line.Qty.Amount" Min="0" Max="10000" Style="width: 100px" />
    <RadzenDropDown @bind-Value="Line.Qty.Unit" Data="Enum.GetValues<Unit>()" Style="width: 150px" />
    <RadzenTextBox @bind-Value="Line.Notes" Placeholder="Notes" Style="width: 200px" />
    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="RemoveRequested" />
</div>

@code {
    /// <summary>
    /// L'objet IngredientLine à éditer par ce composant.
    /// C'est un paramètre obligatoire passé par le parent.
    /// </summary>
    [Parameter] public IngredientLine Line { get; set; } = new();

    /// <summary>
    /// Callback d'événement déclenché lorsque l'utilisateur demande la suppression de cette ligne d'ingrédient.
    /// Le composant parent doit s'abonner à cet événement pour gérer la suppression.
    /// </summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>
    /// Méthode interne qui invoque le callback OnRemove lorsque le bouton de suppression est cliqué.
    /// </summary>
    /// <returns>Une tâche asynchrone.</returns>
    Task RemoveRequested() => OnRemove.InvokeAsync();
}
