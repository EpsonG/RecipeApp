@page "/recipes"
@rendermode InteractiveServer
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService
@using RecipeApp_Eboaguillaume.Models
@inject NavigationManager Navigation
@inject Radzen.NotificationService Notify

<PageTitle>Recettes</PageTitle>

<RadzenNotification />

<div class="recipes-header">
    <div>
        <h1 class="recipes-title">Vos recettes</h1>
        <p class="recipes-subtitle">@allRecipes.Count recette(s) au total</p>
    </div>
    <div class="recipes-actions">
        <RadzenTextBox Placeholder="Rechercher une recette..." @oninput="OnSearch" Style="width: 240px;" />
        <RadzenButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium"
                      Click="@(() => Reload(showNotification: true))" />
        <RadzenButton Icon="add" Text="Nouvelle recette" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium"
                      Click="@(() => Navigation.NavigateTo("/recipes/new"))" />
    </div>
</div>

@if (!filteredRecipes.Any())
{
    <div class="recipes-empty">
        <span class="rzi recipes-empty-icon">soup_kitchen</span>
        <p>@(allRecipes.Any() ? "Aucune recette ne correspond à votre recherche." : "Aucune recette pour l'instant.")</p>
        <RadzenButton Icon="add" Text="Créer une recette" ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Navigation.NavigateTo("/recipes/new"))" />
    </div>
}
else
{
    <div class="recipes-grid">
        @foreach (var recipe in filteredRecipes)
        {
            <div class="recipe-card" @onclick="@(() => View(recipe))">
                <div class="recipe-card-top">
                    <span class="recipe-card-icon">@GetEmoji(recipe)</span>
                    <span class="recipe-card-servings">@recipe.Servings pers.</span>
                </div>
                <h3 class="recipe-card-title">@recipe.Title</h3>
                <p class="recipe-card-description">@recipe.Description</p>

                @if (recipe.Tags.Any())
                {
                    <div class="recipe-card-tags">
                        @foreach (var tag in recipe.Tags.Take(3))
                        {
                            <span class="recipe-tag">@tag</span>
                        }
                    </div>
                }

                <div class="recipe-card-actions" @onclick:stopPropagation="true">
                    <button class="recipe-icon-btn" title="Voir" @onclick="@(() => View(recipe))">
                        <span class="rzi">visibility</span>
                    </button>
                    <button class="recipe-icon-btn" title="Modifier" @onclick="@(() => Edit(recipe))">
                        <span class="rzi">edit</span>
                    </button>
                    <button class="recipe-icon-btn danger" title="Supprimer" @onclick="@(() => Delete(recipe))">
                        <span class="rzi">delete</span>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    List<Recipe> allRecipes = new();
    IEnumerable<Recipe> filteredRecipes = new List<Recipe>();
    string searchTerm = string.Empty;

    private static readonly string[] Emojis = { "🍳", "🍲", "🥘", "🍜", "🥗", "🍰", "🍛", "🥧" };

    protected override void OnInitialized()
    {
        Reload(showNotification: false);
    }

    void Reload(bool showNotification = true)
    {
        allRecipes = RecipeService.GetAll();
        ApplyFilter();

        if (showNotification)
        {
            Notify.Notify(new Radzen.NotificationMessage
            {
                Severity = Radzen.NotificationSeverity.Success,
                Summary = "Actualisé",
                Detail = $"{allRecipes.Count} recette(s) chargée(s).",
                Duration = 3000
            });
        }
    }

    void OnSearch(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    void ApplyFilter()
    {
        filteredRecipes = string.IsNullOrWhiteSpace(searchTerm)
            ? allRecipes
            : allRecipes.Where(r => r.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                                 || (r.Description != null && r.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
    }

    string GetEmoji(Recipe recipe) => Emojis[Math.Abs(recipe.Title.GetHashCode()) % Emojis.Length];

    void View(Recipe r) => Navigation.NavigateTo($"/recipes/{r.Id}");

    void Edit(Recipe r) => Navigation.NavigateTo($"/recipes/edit/{r.Id}");

    void Delete(Recipe r)
    {
        var ok = RecipeService.Delete(r.Id);
        if (ok)
        {
            Reload(showNotification: false);
            Notify.Notify(new Radzen.NotificationMessage
            {
                Severity = Radzen.NotificationSeverity.Success,
                Summary = "Supprimée",
                Detail = $"{r.Title} a été supprimée.",
                Duration = 3000
            });
        }
        else
        {
            Notify.Notify(new Radzen.NotificationMessage
            {
                Severity = Radzen.NotificationSeverity.Warning,
                Summary = "Attention",
                Detail = "Impossible de supprimer cette recette.",
                Duration = 3000
            });
        }
    }
}
