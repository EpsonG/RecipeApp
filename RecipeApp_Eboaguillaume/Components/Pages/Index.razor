@page "/home"
@inject Radzen.NotificationService Notify

<PageTitle>Home</PageTitle>
<RadzenNotification />

<RadzenCard>
    <h1 class="text-2xl font-bold mb-4">RecipoFast!</h1>
    <p class="mb-4">
        Bienvenue dans RecipoFast, votre application de gestion de recettes rapide et facile à utiliser.
        Utilisez le menu de navigation pour parcourir, ajouter et gérer vos recettes préférées.
    </p>
    <RadzenButton Text="Info" ButtonStyle="ButtonStyle.Info" Icon="info"
                  Click="@ShowInfo" />
</RadzenCard>

@code {
    void ShowInfo()
    {
        Notify.Notify(new Radzen.NotificationMessage
        {
            Severity = Radzen.NotificationSeverity.Info,
            Summary = "Application Info",
            Detail = "RecipoFast App Version 1.0.0",
            Duration = 4000
        });
    }
}
