@page "/admin"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService
@inject RecipeApp_Eboaguillaume.Services.IRequestService RequestService
@inject NavigationManager Navigation

@using RecipeApp_Eboaguillaume.Models

<PageTitle>Tableau de bord</PageTitle>

<h1 class="page-title">Tableau de bord</h1>
<p class="page-subtitle">Vue d'ensemble de votre application de recettes.</p>

@if (isLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="margin-bottom: 20px" />
}
else
{
    <div class="dash-stats">
        <div class="dash-stat-card">
            <span class="dash-stat-icon recipes">🍳</span>
            <div>
                <div class="dash-stat-label">Total de recettes</div>
                <div class="dash-stat-value">@totalRecipes</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <span class="dash-stat-icon requests">💌</span>
            <div>
                <div class="dash-stat-label">Total de requêtes</div>
                <div class="dash-stat-value">@totalRequests</div>
            </div>
        </div>
        <div class="dash-stat-card">
            <span class="dash-stat-icon top">🏆</span>
            <div>
                <div class="dash-stat-label">Recette la plus demandée</div>
                <div class="dash-stat-value dash-stat-value-text">@(topRecipeTitle ?? "—")</div>
            </div>
        </div>
    </div>

    <div class="dash-card">
        <h2 class="dash-card-title">Demandes par recette</h2>
        <RadzenChart style="height: 280px; width: 100%;">
            <RadzenColumnSeries Data="@chartData" CategoryProperty="RecipeTitle" ValueProperty="RecipeCount"
                                Title="Demandes" Fill="#C2410C" />
            <RadzenCategoryAxis />
            <RadzenValueAxis />
        </RadzenChart>
    </div>

    <div class="dash-links">
        <a class="dash-link-card" href="/admin/recipes">
            <span class="rzi">restaurant_menu</span>
            <span>Gestion des recettes</span>
        </a>
        <a class="dash-link-card" href="/admin/requests">
            <span class="rzi">forum</span>
            <span>Voir les requêtes</span>
        </a>
        <a class="dash-link-card" href="/admin/change-password">
            <span class="rzi">password</span>
            <span>Changer le mot de passe</span>
        </a>
    </div>
}

@code {
    private bool isLoading = true;
    /// <summary>
    /// Le nombre total de recettes dans le système.
    /// </summary>
    private int totalRecipes;
    /// <summary>
    /// Le nombre total de requêtes de consultation de recettes.
    /// </summary>
    private int totalRequests;
    private string? topRecipeTitle;
    /// <summary>
    /// Les données pour le graphique montrant le nombre de requêtes par recette.
    /// </summary>
    private List<RecipeRequestStat> chartData = new();

    /// <summary>
    /// Méthode appelée lors de l'initialisation du composant pour charger les données.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            var recipes = RecipeService.GetAll();
            var requests = RequestService.GetAll();
            var countsByRecipeId = requests
                .GroupBy(r => r.RecipeId)
                .ToDictionary(g => g.Key, g => g.Count());

            totalRecipes = recipes.Count;
            totalRequests = requests.Count;
            chartData = recipes.Select(r => new RecipeRequestStat
            {
                RecipeTitle = r.Title,
                RecipeCount = countsByRecipeId.TryGetValue(r.Id, out var count) ? count : 0
            }).ToList();

            topRecipeTitle = chartData.OrderByDescending(c => c.RecipeCount).FirstOrDefault(c => c.RecipeCount > 0)?.RecipeTitle;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
