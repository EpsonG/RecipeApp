@page "/admin/requests"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject RecipeApp_Eboaguillaume.Services.MySqlRequestService MySqlRequestService
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService

<PageTitle>Requêtes de recettes</PageTitle>

<RadzenCard>
    <h3>Demandes reçues</h3>

    <RadzenDataGrid Data="@requests" TItem="RecipeApp_Eboaguillaume.Models.RecipeRequest">
        <Columns>
            <RadzenDataGridColumn Property="RequestedBy" Title="Demandeur" />
            <RadzenDataGridColumn Property="RequestedOn" Title="Date" />
            <RadzenDataGridColumn Title="Recette">
                <Template Context="r">
                    @(recipeTitlesById.TryGetValue(r.RecipeId, out var title) ? title : "")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    List<RecipeApp_Eboaguillaume.Models.RecipeRequest> requests = new();
    Dictionary<int, string> recipeTitlesById = new();

    protected override void OnInitialized()
    {
        requests = MySqlRequestService.GetAll();
        recipeTitlesById = RecipeService.GetAll().ToDictionary(r => r.Id, r => r.Title);
    }
}

