@page "/admin/recipes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService
@inject Radzen.NotificationService Notify
@inject Radzen.DialogService Dialog
@inject NavigationManager Navigation
@using RecipeApp_Eboaguillaume.Models

<PageTitle>Gestion des recettes</PageTitle>

<RadzenNotification />
<RadzenDialog />

<a class="page-back" href="/admin">&larr; Tableau de bord</a>
<h1 class="page-title">Gestion des recettes</h1>

<div class="admin-table-card">
    <RadzenDataGrid Data="@recipes" TItem="Recipe" RowDoubleClick="@(args => View(args.Data))" AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenDataGridColumn Property="Title" Title="Titre" />
            <RadzenDataGridColumn Property="Description" Title="Description" />
            <RadzenDataGridColumn Title="Publiée" Width="110px" Sortable="false" Filterable="false">
                <Template Context="r">
                    <RadzenSwitch Value="@r.IsPublished" TValue="bool" Change="@(args => TogglePublish(r, args))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Actions" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                <Template Context="r">
                    <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => View(r))" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" class="ms-1"
                                  Click="@(() => Delete(r))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    /// <summary>
    /// La liste des recettes à afficher et gérer.
    /// </summary>
    List<RecipeApp_Eboaguillaume.Models.Recipe> recipes = new();

    /// <summary>
    /// Initialise la liste des recettes au chargement du composant.
    /// </summary>
    protected override void OnInitialized() => recipes = RecipeService.GetAll();

    /// <summary>
    /// Ouvre la fiche détaillée de la recette.
    /// </summary>
    void View(RecipeApp_Eboaguillaume.Models.Recipe r) => Navigation.NavigateTo($"/recipes/{r.Id}");

    /// <summary>
    /// Gère la suppression d'une recette après confirmation de l'utilisateur.
    /// </summary>
    async Task Delete(RecipeApp_Eboaguillaume.Models.Recipe r)
    {
        var confirmed = await Dialog.Confirm($"Êtes-vous sûr de vouloir supprimer '{r.Title}' ?", "Confirmation de suppression", new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirmed == true)
        {
            RecipeService.Delete(r.Id);
            recipes = RecipeService.GetAll(); // Refresh the list
            Notify.Notify(NotificationSeverity.Success, "Suppression", $"{r.Title} a été supprimée.");
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Met à jour le statut de publication d'une recette.
    /// </summary>
    /// <param name="recipe">La recette à mettre à jour.</param>
    /// <param name="isPublished">Le nouveau statut de publication.</param>
    void TogglePublish(Recipe recipe, bool isPublished)
    {
        recipe.IsPublished = isPublished;
        RecipeService.Update(recipe);
        var status = isPublished ? "publiée" : "dépubliée";
        Notify.Notify(NotificationSeverity.Info, "Mise à jour", $"La recette '{recipe.Title}' a été {status}.");
    }
}
