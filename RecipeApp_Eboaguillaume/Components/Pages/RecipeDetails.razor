@page "/recipes/{Id:int}"
@rendermode InteractiveServer
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService
@inject RecipeApp_Eboaguillaume.Services.MySqlRequestService MySqlRequestService
@inject NavigationManager Navigation
@inject Radzen.NotificationService Notify

<PageTitle>@recipe?.Title</PageTitle>

<RadzenNotification />

@if (recipe == null)
{
    <RadzenAlert Severity="AlertSeverity.Warning" Summary="Introuvable" Detail="Cette recette n'existe pas." />
}
else
{
    <a class="page-back" href="/recipes">&larr; Toutes les recettes</a>

    <div class="detail-hero">
        <span class="detail-emoji">@Emoji</span>
        <div class="detail-hero-text">
            <h1 class="detail-title">@recipe.Title</h1>
            <p class="detail-description">@recipe.Description</p>
            <div class="detail-badges">
                <span class="detail-badge servings">@recipe.Servings pers.</span>
                @foreach (var tag in recipe.Tags)
                {
                    <span class="detail-badge tag">@tag</span>
                }
            </div>
        </div>
    </div>

    <div class="detail-actions">
        <RadzenButton Icon="edit" Text="Modifier" ButtonStyle="ButtonStyle.Primary" Click="@(() => Edit(recipe.Id))" />
        <RadzenButton Icon="content_copy" Text="Dupliquer" ButtonStyle="ButtonStyle.Light" Click="@(() => Duplicate(recipe))" />
        <RadzenButton Icon="favorite" Text="Je veux cette recette" ButtonStyle="ButtonStyle.Light" Click="RequestRecipe" />
    </div>

    <div class="detail-grid">
        <div class="detail-card">
            <h2 class="detail-card-title">Ingrédients</h2>
            <ul class="detail-ingredients">
                @foreach (var ing in recipe.Ingredients)
                {
                    <li>
                        <span class="detail-check">✓</span>
                        <span>@ing.Qty.Amount @ing.Qty.Unit.ToString().ToLower() @ing.Name</span>
                    </li>
                }
            </ul>
        </div>
        <div class="detail-card">
            <h2 class="detail-card-title">Étapes</h2>
            <ol class="detail-steps">
                @foreach (var step in recipe.Steps.OrderBy(s => s.Order))
                {
                    <li>
                        <span class="detail-step-number">@step.Order</span>
                        <span>@step.Text</span>
                    </li>
                }
            </ol>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeApp_Eboaguillaume.Models.Recipe? recipe;

    private static readonly string[] Emojis = { "🍳", "🍲", "🥘", "🍜", "🥗", "🍰", "🍛", "🥧" };
    private string Emoji => recipe is null ? "🍽️" : Emojis[Math.Abs(recipe.Title.GetHashCode()) % Emojis.Length];

    protected override void OnInitialized()
    {
        recipe = RecipeService.Get(Id);
    }

    void Edit(int recipeId) => Navigation.NavigateTo($"/recipes/edit/{recipeId}");

    void Duplicate(RecipeApp_Eboaguillaume.Models.Recipe originalRecipe)
    {
        var newRecipe = originalRecipe.Clone();
        RecipeService.Add(newRecipe);
        Navigation.NavigateTo($"/recipes/edit/{newRecipe.Id}");
    }

    void RequestRecipe()
    {
        if (recipe is null) return;
        MySqlRequestService.AddRequest(recipe.Id, "Etudiant");
        Notify.Notify(Radzen.NotificationSeverity.Success, "Merci !", "Votre intérêt pour cette recette a été enregistré.");
    }
}
