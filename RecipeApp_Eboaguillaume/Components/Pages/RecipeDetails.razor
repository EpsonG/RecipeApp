@page "/recipes/{Id:int}"
@rendermode InteractiveServer
@inject RecipeApp_Eboaguillaume.Services.IRecipeService RecipeService
@inject RecipeApp_Eboaguillaume.Services.MySqlRequestService MySqlRequestService
@inject NavigationManager Navigation

<PageTitle>@recipe?.Title</PageTitle>

@if (recipe == null)
{
    <RadzenAlert Severity="AlertSeverity.Warning" Summary="Not Found" Detail="Sorry, recipe not found." />
}
else
{
    <RadzenCard>
        <RadzenNotification />
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h1 class="fs-2 fw-bold">@recipe.Title</h1>
                <p class="text-muted">@recipe.Description</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <RadzenButton Icon="edit" Text="Edit" ButtonStyle="ButtonStyle.Primary" Click="@(() => Edit(recipe.Id))" />
                <RadzenButton Icon="content_copy" Text="Duplicate" ButtonStyle="ButtonStyle.Secondary" Click="@(() => Duplicate(recipe))" />
                <RadzenButton Icon="favorite" Text="Je veux cette recette" ButtonStyle="ButtonStyle.Primary" Click="@(() => MySqlRequestService.AddRequest(recipe.Id, "Etudiant"))" />
            </div>
        </div>

        <div class="mt-4">
            <RadzenBadge Text=@($"Serves {recipe.Servings}") BadgeStyle="BadgeStyle.Info" />
            @foreach (var tag in recipe.Tags)
            {
                <RadzenBadge Text="@tag" IsPill="true" class="ms-1" />
            }
        </div>

        <RadzenRow Gap="2rem" class="mt-4">
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFieldset Text="Ingredients">
                    <ul>
                        @foreach (var ing in recipe.Ingredients)
                        {
                            <li>@ing.Qty.Amount @ing.Qty.Unit.ToString().ToLower() @ing.Name</li>
                        }
                    </ul>
                </RadzenFieldset>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="8">
                <RadzenFieldset Text="Steps">
                    <ol>
                        @foreach (var step in recipe.Steps.OrderBy(s => s.Order))
                        {
                            <li class="mb-2">@step.Text</li>
                        }
                    </ol>
                </RadzenFieldset>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private RecipeApp_Eboaguillaume.Models.Recipe? recipe;

    protected override void OnInitialized()
    {
        recipe = RecipeService.Get(Id);
    }

    void Edit(int recipeId) => Navigation.NavigateTo($"/recipes/edit/{recipeId}");

    void Duplicate(RecipeApp_Eboaguillaume.Models.Recipe originalRecipe)
    {
        var newRecipe = originalRecipe.Clone();
        RecipeService.Add(newRecipe);
        Navigation.NavigateTo($"/recipes/edit/{newRecipe.Id}");
    }
}