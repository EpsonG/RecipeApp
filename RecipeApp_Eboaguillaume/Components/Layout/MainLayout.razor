@using Radzen
@using Radzen.Blazor
@inherits LayoutComponentBase

@* Layout principal de l'application.
   - Utilise les composants Radzen pour construire une sidebar
     et une zone de contenu principale.
   - Le placeholder `@Body` rendra le contenu des pages enfants. *@
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenSidebarToggle Click="@(() => sidebar1Expanded = !sidebar1Expanded)" />
            <RadzenText Text="Recipe App" TextStyle="TextStyle.H5" TagName="TagName.H1" class="rz-color-white" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebar1Expanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Path="/" Icon="home" />
            <RadzenPanelMenuItem Text="Dashboard" Path="/admin" Icon="dashboard" />
            <RadzenPanelMenuItem Text="Recettes" Path="/recipes" Icon="restaurant_menu" />
            <RadzenPanelMenuItem Text="Requêtes" Path="/admin/requests" Icon="search"/>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="container">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    bool sidebar1Expanded = true;
}

